{
  "name": "is1-planificador-de-estudios",
  "version": "0.1.0",
  "description": "Planificador de estudios: cuentas y tareas personales",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file=.env --import tsx --watch server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file=.env --import tsx server/index.ts",
    "test": "vitest run tests/api.test.ts",
    "test:e2e": "playwright test",
    "test:server": "node --import tsx tests/test-server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
